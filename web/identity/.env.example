# Safe Vercel UI preview: login stays disabled until public ingress acceptance.
NEXT_PUBLIC_BFF_ACCOUNTS_ENABLED=false
NEXT_PUBLIC_BFF_REGISTRATION_ENABLED=false
NEXT_PUBLIC_BFF_RECOVERY_ENABLED=false
NEXT_PUBLIC_PRIVATE_TEST_MODE=false
# The private VPS bundle CI enables all account flags and private test mode.
# No database password, signing key or provider credential belongs in NEXT_PUBLIC_*.

# Server-only transport; keep disabled until the authenticated VPS gateway is accepted.
SMARTCORE_BFF_BRIDGE_ENABLED=false
# SMARTCORE_BROWSER_ORIGIN=https://your-stable-frontend.vercel.app
# SMARTCORE_BFF_GATEWAY_ORIGIN=https://your-vps-gateway.example
# SMARTCORE_BFF_GATEWAY_KEY=<separate gateway key from a secret store; never NEXT_PUBLIC>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate internal refresh security event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "schemaVersion",
    "type",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "const": "0.1.0"
    },
    "type": {
      "enum": [
        "RefreshTokenRotated",
        "RefreshTokenReuseDetected"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "familyId",
        "generation",
        "occurredAt",
        "reason"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "familyId": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "enum": [
            "RefreshAccepted",
            "PreviouslyConsumedGeneration"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "RefreshTokenRotated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "reason": {
                "const": "RefreshAccepted"
              },
              "generation": {
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "RefreshTokenReuseDetected"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "reason": {
                "const": "PreviouslyConsumedGeneration"
              },
              "generation": {
                "minimum": 0
              }
            }
          }
        }
      }
    }
  ]
}

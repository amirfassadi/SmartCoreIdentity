{
  "type": "object",
  "properties": {
    "EventId": {
      "type": "string",
      "format": "uuid"
    },
    "EventType": {
      "const": "PasswordChanged"
    },
    "AggregateType": {
      "const": "Credential"
    },
    "AggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "OccurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "ActorIdentity": {
      "type": "string",
      "format": "uuid"
    },
    "SessionReference": {
      "type": "string",
      "format": "uuid"
    },
    "ExecutionContext": {
      "type": "object",
      "properties": {
        "CorrelationId": {
          "type": "string"
        },
        "IpAddress": {
          "type": "string"
        },
        "DeviceInfo": {
          "type": "string"
        },
        "RecoveryProofReference": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Payload": {
      "type": "object",
      "properties": {
        "PersonId": {
          "type": "string",
          "format": "uuid"
        },
        "CredentialId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "PersonId",
        "CredentialId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "EventId",
    "EventType",
    "AggregateType",
    "AggregateId",
    "OccurredAt",
    "ActorIdentity",
    "Payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ActorIdentity": {
            "not": {
              "const": "System"
            }
          }
        }
      },
      "then": {
        "required": [
          "ExecutionContext"
        ],
        "properties": {
          "ExecutionContext": {
            "required": [
              "CorrelationId"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "ExecutionContext"
        ],
        "properties": {
          "ExecutionContext": {
            "required": [
              "RecoveryProofReference"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "SessionReference"
          ]
        }
      },
      "else": {
        "required": [
          "SessionReference"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed PasswordChanged reset-proof context extension",
  "description": "Owner review candidate only. Existing pinned input and public runtime remain unchanged."
}

        "OccurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "ActorIdentity": {
          "type": "string",
          "format": "uuid"
        },
        "ExecutionContext": {
          "type": "object",
          "properties": {
            "CorrelationId": {
              "type": "string"
            },
            "IpAddress": {
              "type": "string"
            },
            "DeviceInfo": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "Payload": {
          "type": "object",
          "properties": {
            "ContactType": {
              "enum": [
                "Email",
                "Mobile"
              ]
            },
            "ContactValue": {
              "type": "string"
            },
            "Reason": {
              "enum": [
                "PersonNotFound",
                "CredentialMissing",
                "RegistrationNotReady",
                "PersonInactive",
                "InvalidPassword"
              ]
            }
          },
          "required": [
            "ContactType",
            "ContactValue",
            "Reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "EventId",
        "EventType",
        "AggregateType",
        "OccurredAt",
        "Payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ActorIdentity": {
                "not": {
                  "const": "System"
                }
              }
            }
          },
          "then": {
            "required": [
              "ExecutionContext"
            ],
            "properties": {
              "ExecutionContext": {
                "required": [
                  "CorrelationId"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "Payload": {
                "properties": {
                  "Reason": {
                    "const": "PersonNotFound"
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ActorIdentity"
                  ]
                },
                {
                  "required": [
                    "AggregateId"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "ActorIdentity",
              "AggregateId"
            ]
          }
        }
      ]
    },

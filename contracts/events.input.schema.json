    "PersonRegistered": {
      "type": "object",
      "properties": {
        "EventId": {
          "type": "string",
          "format": "uuid"
        },
        "EventType": {
          "const": "PersonRegistered"
        },
        "AggregateType": {
          "const": "Person"
        },
        "AggregateId": {
          "type": "string",
          "format": "uuid"
        },
        "OccurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "ActorIdentity": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "const": "System"
            }
          ]
        },
        "ExecutionContext": {
          "type": "object",
          "properties": {
            "CorrelationId": {
              "type": "string"
            },
            "IpAddress": {
              "type": "string"
            },
            "DeviceInfo": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "Payload": {
          "type": "object",
          "properties": {
            "PersonId": {
              "type": "string",
              "format": "uuid"
            },
            "Email": {
              "type": "string",
              "format": "email",
              "maxLength": 254
            },
            "DisplayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "OrganizationId": {
              "type": "string",
              "format": "uuid"
            },
            "MembershipId": {
              "type": "string",
              "format": "uuid"
            },
            "OwnershipCommittedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "PersonId",
            "DisplayName",
            "OrganizationId",
            "MembershipId",
            "OwnershipCommittedAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "EventId",
        "EventType",
        "AggregateType",
        "AggregateId",
        "OccurredAt",
        "ActorIdentity",
        "Payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ActorIdentity": {
                "not": {
                  "const": "System"
                }
              }
            }
          },
          "then": {
            "required": [
              "ExecutionContext"
            ],
            "properties": {
              "ExecutionContext": {
                "required": [
                  "CorrelationId"
                ]
              }
            }
          }
        }
      ]
    },

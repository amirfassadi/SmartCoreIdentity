            }
          }
        },
        {
          "if": {
            "required": [
              "ExecutionContext"
            ],
            "properties": {
              "ExecutionContext": {
                "required": [
                  "RecoveryProofReference"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "SessionReference"
              ]
            }
          },
          "else": {
            "required": [
              "SessionReference"
            ]
          }
        }
      ]
